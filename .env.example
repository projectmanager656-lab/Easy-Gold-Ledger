# Gold Loan Management Software - Firebase Credentials
# Copy this file to '.env' and fill in your details from the Firebase Console

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Live Gold & Silver Market Feed (gold-api.com)
VITE_GOLD_API_URL=https://api.gold-api.com
VITE_GOLD_API_KEY=your-gold-api-key-here

# Indian Retail Price Adapter (spot -> Indian retail conversion)
# Import duty 15% (10% BCD + 5% AIDC, eff. 13 May 2026) + GST 3% + market spread.
# Tune VITE_GOLD_MARKET_PREMIUM to track your local jeweller / NBFC board rates.
VITE_GOLD_IMPORT_DUTY_RATE=0.15
VITE_GOLD_GST_RATE=0.03
VITE_GOLD_MARKET_PREMIUM=-0.045
